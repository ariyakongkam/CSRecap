# Web server settings for csgg (Caddy, https://caddyserver.com).
# serve.bat fills in CSGG_DOMAIN (your domain) and CSGG_SITE (the built site from publish.bat).
# Caddy gets and renews the HTTPS certificate for your domain by itself.

{$CSGG_DOMAIN} {
	root * "{$CSGG_SITE}"
	encode zstd gzip

	# Pages are files like app.html; serve them at /app.
	try_files {path} {path}.html {path}/index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	header /opengraph-image Content-Type image/png
	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"

	handle_errors {
		root * "{$CSGG_SITE}"
		rewrite * /404.html
		file_server
	}
}
